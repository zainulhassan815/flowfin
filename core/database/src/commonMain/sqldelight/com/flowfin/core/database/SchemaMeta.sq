-- Key/value store for schema metadata that needs to outlive the schema:
-- schema version, install device id, future-sync bookkeeping.

CREATE TABLE schema_meta (
  key   TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);


get:
SELECT value
FROM schema_meta
WHERE key = ?;

set:
INSERT INTO schema_meta(key, value)
VALUES (?, ?)
ON CONFLICT(key) DO UPDATE SET value = excluded.value;

selectAll:
SELECT * FROM schema_meta;
