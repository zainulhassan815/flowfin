import com.flowfin.core.model.AccountId;
import com.flowfin.core.model.CategoryId;
import com.flowfin.core.model.DebtId;
import com.flowfin.core.model.RecurringScheduleId;
import com.flowfin.core.model.TransactionId;
import com.flowfin.core.model.TransactionKind;
import kotlinx.datetime.Instant;

-- The ledger. One row per cash event. `kind` discriminates the nine
-- event shapes; nullability is enforced per-kind by CHECK.
--
-- `debt_id` is a deferred FK so a debt and its origin transaction can be
-- inserted inside one `db.transaction { ... }`.

CREATE TABLE transactions (
  id              BLOB    AS TransactionId        NOT NULL PRIMARY KEY,
  kind            TEXT    AS TransactionKind      NOT NULL,
  from_account_id BLOB    AS AccountId                     REFERENCES accounts(id)            ON DELETE RESTRICT,
  to_account_id   BLOB    AS AccountId                     REFERENCES accounts(id)            ON DELETE RESTRICT,
  amount_minor    INTEGER                          NOT NULL,
  category_id     BLOB    AS CategoryId                    REFERENCES categories(id)          ON DELETE SET NULL,
  note            TEXT,
  recorded_at     INTEGER AS Instant               NOT NULL,
  recurring_id    BLOB    AS RecurringScheduleId           REFERENCES recurring_schedules(id) ON DELETE SET NULL,
  debt_id         BLOB    AS DebtId,
  created_at      INTEGER AS Instant               NOT NULL,
  updated_at      INTEGER AS Instant               NOT NULL,
  FOREIGN KEY (debt_id) REFERENCES debts(id) DEFERRABLE INITIALLY DEFERRED,

  CHECK (amount_minor > 0),

  CHECK (kind IN (
    'INCOME', 'EXPENSE', 'TRANSFER',
    'ALLOCATION', 'REALLOCATION',
    'DEBT_BORROW', 'DEBT_LEND',
    'DEBT_REPAY_OUT', 'DEBT_REPAY_IN'
  )),

  -- Per-kind nullability shape.
  CHECK (
    (kind = 'INCOME'         AND from_account_id IS NULL     AND to_account_id IS NOT NULL AND category_id IS NOT NULL AND debt_id IS NULL)
    OR (kind = 'EXPENSE'         AND from_account_id IS NOT NULL AND to_account_id IS NULL     AND category_id IS NOT NULL AND debt_id IS NULL)
    OR (kind = 'TRANSFER'        AND from_account_id IS NOT NULL AND to_account_id IS NOT NULL AND category_id IS NULL     AND debt_id IS NULL)
    OR (kind = 'ALLOCATION'      AND from_account_id IS NOT NULL AND to_account_id IS NOT NULL AND category_id IS NULL     AND debt_id IS NULL)
    OR (kind = 'REALLOCATION'    AND from_account_id IS NOT NULL AND to_account_id IS NOT NULL AND category_id IS NULL     AND debt_id IS NULL)
    -- Debt kinds: the structurally-impossible side is always NULL (a borrow can
    -- never move money out of your own account, etc.); the other side is
    -- optional — off-book debts/repayments (no linked account) leave it NULL too.
    OR (kind = 'DEBT_BORROW'     AND from_account_id IS NULL                                    AND category_id IS NULL     AND debt_id IS NOT NULL)
    OR (kind = 'DEBT_LEND'       AND to_account_id IS NULL                                       AND category_id IS NULL     AND debt_id IS NOT NULL)
    OR (kind = 'DEBT_REPAY_OUT'  AND to_account_id IS NULL                                       AND category_id IS NULL     AND debt_id IS NOT NULL)
    OR (kind = 'DEBT_REPAY_IN'   AND from_account_id IS NULL                                    AND category_id IS NULL     AND debt_id IS NOT NULL)
  ),

  -- Recurring schedules don't fire debt payments in v0.
  CHECK (recurring_id IS NULL OR debt_id IS NULL),

  -- Only INCOME / EXPENSE / ALLOCATION rows are linked to a schedule. Allocation
  -- is here because a budget funds itself on a schedule ("Food, Rs 28,000, the
  -- 1st"), which is a recurring move from a real account into its envelope.
  CHECK ((kind IN ('INCOME', 'EXPENSE', 'ALLOCATION')) OR recurring_id IS NULL),

  -- No self-loops.
  CHECK (from_account_id IS NULL OR to_account_id IS NULL OR from_account_id != to_account_id)
);

CREATE INDEX tx_recorded_at       ON transactions(recorded_at DESC);
CREATE INDEX tx_from_recorded     ON transactions(from_account_id, recorded_at DESC);
CREATE INDEX tx_to_recorded       ON transactions(to_account_id,   recorded_at DESC);
CREATE INDEX tx_category_recorded ON transactions(category_id, recorded_at DESC) WHERE category_id IS NOT NULL;
CREATE INDEX tx_debt              ON transactions(debt_id)      WHERE debt_id      IS NOT NULL;
CREATE INDEX tx_recurring         ON transactions(recurring_id) WHERE recurring_id IS NOT NULL;
CREATE INDEX tx_kind_recorded     ON transactions(kind, recorded_at DESC);

-- Cross-row invariants that CHECK can't subquery for.

-- Both endpoints must share currency.
CREATE TRIGGER tx_currency_match_ins
BEFORE INSERT ON transactions
WHEN new.from_account_id IS NOT NULL AND new.to_account_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN (SELECT currency FROM accounts WHERE id = new.from_account_id)
       != (SELECT currency FROM accounts WHERE id = new.to_account_id)
    THEN RAISE(ABORT, 'currency mismatch between accounts')
  END;
END;

CREATE TRIGGER tx_currency_match_upd
BEFORE UPDATE OF from_account_id, to_account_id ON transactions
WHEN new.from_account_id IS NOT NULL AND new.to_account_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN (SELECT currency FROM accounts WHERE id = new.from_account_id)
       != (SELECT currency FROM accounts WHERE id = new.to_account_id)
    THEN RAISE(ABORT, 'currency mismatch between accounts')
  END;
END;

-- Category scope must match the row's kind.
CREATE TRIGGER tx_category_scope_ins
BEFORE INSERT ON transactions
WHEN new.category_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN new.kind = 'INCOME'  AND (SELECT scope FROM categories WHERE id = new.category_id) != 'INCOME'
      THEN RAISE(ABORT, 'INCOME row needs INCOME-scope category')
    WHEN new.kind = 'EXPENSE' AND (SELECT scope FROM categories WHERE id = new.category_id) != 'EXPENSE'
      THEN RAISE(ABORT, 'EXPENSE row needs EXPENSE-scope category')
  END;
END;

CREATE TRIGGER tx_category_scope_upd
BEFORE UPDATE OF kind, category_id ON transactions
WHEN new.category_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN new.kind = 'INCOME'  AND (SELECT scope FROM categories WHERE id = new.category_id) != 'INCOME'
      THEN RAISE(ABORT, 'INCOME row needs INCOME-scope category')
    WHEN new.kind = 'EXPENSE' AND (SELECT scope FROM categories WHERE id = new.category_id) != 'EXPENSE'
      THEN RAISE(ABORT, 'EXPENSE row needs EXPENSE-scope category')
  END;
END;

-- A REALLOCATION must stay within one real parent.
CREATE TRIGGER tx_reallocation_same_parent_ins
BEFORE INSERT ON transactions
WHEN new.kind = 'REALLOCATION'
BEGIN
  SELECT CASE
    WHEN (SELECT parent_account_id FROM accounts WHERE id = new.from_account_id)
       != (SELECT parent_account_id FROM accounts WHERE id = new.to_account_id)
    THEN RAISE(ABORT, 'reallocation must stay within the same real parent')
  END;
END;

-- New transactions cannot post against an archived account. Back-dating an
-- old row whose recorded_at precedes archival is enforced at the domain layer.
CREATE TRIGGER tx_no_writes_to_archived_from_ins
BEFORE INSERT ON transactions
WHEN new.from_account_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN (SELECT archived_at FROM accounts WHERE id = new.from_account_id) IS NOT NULL
    THEN RAISE(ABORT, 'cannot write to archived from_account')
  END;
END;

CREATE TRIGGER tx_no_writes_to_archived_to_ins
BEFORE INSERT ON transactions
WHEN new.to_account_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN (SELECT archived_at FROM accounts WHERE id = new.to_account_id) IS NOT NULL
    THEN RAISE(ABORT, 'cannot write to archived to_account')
  END;
END;


selectById:
SELECT *
FROM transactions
WHERE id = ?;

-- Newest-first feed, capped at the call site — Home's recent strip and the
-- Transactions list's All view.
feed:
SELECT *
FROM transactions
ORDER BY recorded_at DESC, created_at DESC
LIMIT :limit;

-- Newest-first feed restricted to a set of kinds — the filtered Transactions list.
-- Served by the (kind, recorded_at) index.
feedOfKinds:
SELECT *
FROM transactions
WHERE kind IN :kinds
ORDER BY recorded_at DESC, created_at DESC
LIMIT :limit;

-- Every row touching one account, for Account detail.
byAccount:
SELECT *
FROM transactions
WHERE from_account_id = :accountId OR to_account_id = :accountId
ORDER BY recorded_at DESC, created_at DESC
LIMIT :limit OFFSET :offset;

countByAccount:
SELECT COUNT(*) AS count
FROM transactions
WHERE from_account_id = :accountId OR to_account_id = :accountId;

-- Monthly income/expense totals.
sumByKindInRange:
SELECT kind, COALESCE(SUM(amount_minor), 0) AS total_minor
FROM transactions
WHERE recorded_at >= :startAt AND recorded_at < :endAt
GROUP BY kind;

-- Net change to the headline total over a range. Internal moves (transfers,
-- allocations, reallocations) net to zero across REAL + BUDGET, so only the
-- external flows count: money entering the system is +, money leaving is −.
-- This equals the change in `totalBalance` across the same window. Off-book
-- debt rows (no linked account — see the per-kind CHECK above) contribute 0:
-- they never touched an account, so counting them here would move this figure
-- without moving any actual balance.
netChangeInRange:
SELECT COALESCE(SUM(
  CASE kind
    WHEN 'INCOME'         THEN  amount_minor
    WHEN 'DEBT_BORROW'    THEN CASE WHEN to_account_id   IS NOT NULL THEN  amount_minor ELSE 0 END
    WHEN 'DEBT_REPAY_IN'  THEN CASE WHEN to_account_id   IS NOT NULL THEN  amount_minor ELSE 0 END
    WHEN 'EXPENSE'        THEN -amount_minor
    WHEN 'DEBT_LEND'      THEN CASE WHEN from_account_id IS NOT NULL THEN -amount_minor ELSE 0 END
    WHEN 'DEBT_REPAY_OUT' THEN CASE WHEN from_account_id IS NOT NULL THEN -amount_minor ELSE 0 END
    ELSE 0
  END
), 0) AS net_minor
FROM transactions
WHERE recorded_at >= :startAt AND recorded_at < :endAt;

-- In/out flow for one account over [startAt, endAt). `in` sums rows where the
-- account was the destination (its balance rose), `out` where it was the source
-- (its balance fell); net = in − out is the balance change over the window.
-- Drives the In / Out / Net strip on Account detail.
flowByAccountInRange:
SELECT
  COALESCE(SUM(CASE WHEN to_account_id   = :accountId THEN amount_minor ELSE 0 END), 0) AS in_minor,
  COALESCE(SUM(CASE WHEN from_account_id = :accountId THEN amount_minor ELSE 0 END), 0) AS out_minor
FROM transactions
WHERE (from_account_id = :accountId OR to_account_id = :accountId)
  AND recorded_at >= :startAt AND recorded_at < :endAt;

-- Cumulative expense outflow per account — drives budget-envelope progress
-- (spend vs. funded). Envelopes don't reset, so this is all-time, not ranged.
expenseByAccount:
SELECT from_account_id AS account_id, COALESCE(SUM(amount_minor), 0) AS spent_minor
FROM transactions
WHERE kind = 'EXPENSE' AND from_account_id IS NOT NULL
GROUP BY from_account_id;

-- Expense breakdown by category, for Reports.
expensesByCategoryInRange:
SELECT category_id, COALESCE(SUM(amount_minor), 0) AS total_minor, COUNT(*) AS count
FROM transactions
WHERE kind = 'EXPENSE'
  AND recorded_at >= :startAt
  AND recorded_at <  :endAt
  AND category_id IS NOT NULL
GROUP BY category_id
ORDER BY total_minor DESC;

incomesByCategoryInRange:
SELECT category_id, COALESCE(SUM(amount_minor), 0) AS total_minor, COUNT(*) AS count
FROM transactions
WHERE kind = 'INCOME'
  AND recorded_at >= :startAt
  AND recorded_at <  :endAt
  AND category_id IS NOT NULL
GROUP BY category_id
ORDER BY total_minor DESC;

-- Dated amounts for one kind over a range — the Reports trend chart buckets
-- these into days. Bucketing happens in Kotlin rather than SQL because a day
-- boundary depends on the user's zone, and SQLite would need the offset baked
-- into the query to get it right.
amountsOfKindInRange:
SELECT recorded_at, amount_minor
FROM transactions
WHERE kind = :kind
  AND recorded_at >= :startAt
  AND recorded_at <  :endAt
ORDER BY recorded_at;

-- Row count and most recent use per category — the count pill and the
-- "last used" meta on the Categories screen, in one pass.
usageByCategory:
SELECT
  category_id AS category_id,
  COUNT(*) AS txn_count,
  MAX(recorded_at) AS last_used_at
FROM transactions
WHERE category_id IS NOT NULL
GROUP BY category_id;

-- Payments toward a debt, chronological.
byDebt:
SELECT *
FROM transactions
WHERE debt_id = ?
ORDER BY recorded_at, created_at;

-- Firings of a recurring schedule, newest first.
byRecurring:
SELECT *
FROM transactions
WHERE recurring_id = ?
ORDER BY recorded_at DESC, created_at DESC;

insert:
INSERT INTO transactions (
  id, kind, from_account_id, to_account_id, amount_minor,
  category_id, note, recorded_at, recurring_id, debt_id,
  created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateContent:
UPDATE transactions
SET amount_minor = :amountMinor,
    category_id  = :categoryId,
    note         = :note,
    recorded_at  = :recordedAt,
    updated_at   = :updatedAt
WHERE id = :id;

reassignAccounts:
UPDATE transactions
SET from_account_id = :fromAccountId,
    to_account_id   = :toAccountId,
    updated_at      = :updatedAt
WHERE id = :id;

delete:
DELETE FROM transactions WHERE id = ?;

-- Deleting a debt cascades here first — `transactions.debt_id` has no ON DELETE
-- CASCADE (a debt's own history shouldn't vanish by accident elsewhere), so the
-- debt-screen delete flow clears these explicitly before deleting the debt row.
deleteByDebt:
DELETE FROM transactions WHERE debt_id = ?;
