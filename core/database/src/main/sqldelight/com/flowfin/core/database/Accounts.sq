import com.flowfin.core.model.AccountId;
import com.flowfin.core.model.AccountType;
import kotlinx.datetime.Instant;

-- Real-money locations (Bank, Cash) and budget envelopes (Food, Transport).
-- A BUDGET row points at the REAL account it allocates from.

CREATE TABLE accounts (
  id                    BLOB    AS AccountId   NOT NULL PRIMARY KEY,
  name                  TEXT                   NOT NULL,
  type                  TEXT    AS AccountType NOT NULL,
  currency              TEXT                   NOT NULL DEFAULT 'PKR',
  parent_account_id     BLOB    AS AccountId            REFERENCES accounts(id) ON DELETE RESTRICT,
  opening_balance_minor INTEGER                NOT NULL DEFAULT 0,
  color                 TEXT,
  icon                  TEXT,
  display_order         INTEGER                NOT NULL DEFAULT 0,
  created_at            INTEGER AS Instant     NOT NULL,
  updated_at            INTEGER AS Instant     NOT NULL,
  archived_at           INTEGER AS Instant,
  CHECK (type IN ('REAL', 'BUDGET')),
  CHECK (
    (type = 'REAL'   AND parent_account_id IS NULL)
    OR
    (type = 'BUDGET' AND parent_account_id IS NOT NULL)
  )
);

CREATE UNIQUE INDEX accounts_name_unique
  ON accounts(name)
  WHERE archived_at IS NULL;

-- A budget's parent must be a REAL account. CHECK cannot subquery, so a trigger.
CREATE TRIGGER accounts_parent_must_be_real_ins
BEFORE INSERT ON accounts
WHEN new.parent_account_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN (SELECT type FROM accounts WHERE id = new.parent_account_id) != 'REAL'
    THEN RAISE(ABORT, 'budget parent must be REAL')
  END;
END;

CREATE TRIGGER accounts_parent_must_be_real_upd
BEFORE UPDATE OF parent_account_id ON accounts
WHEN new.parent_account_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN (SELECT type FROM accounts WHERE id = new.parent_account_id) != 'REAL'
    THEN RAISE(ABORT, 'budget parent must be REAL')
  END;
END;

-- A budget inherits its parent's currency.
CREATE TRIGGER accounts_currency_matches_parent_ins
BEFORE INSERT ON accounts
WHEN new.parent_account_id IS NOT NULL
BEGIN
  SELECT CASE
    WHEN (SELECT currency FROM accounts WHERE id = new.parent_account_id) != new.currency
    THEN RAISE(ABORT, 'budget currency must match parent')
  END;
END;


selectAllActive:
SELECT *
FROM accounts
WHERE archived_at IS NULL
ORDER BY display_order, name;

selectAllIncludingArchived:
SELECT *
FROM accounts
ORDER BY archived_at IS NULL DESC, display_order, name;

selectById:
SELECT *
FROM accounts
WHERE id = ?;

selectByType:
SELECT *
FROM accounts
WHERE type = ? AND archived_at IS NULL
ORDER BY display_order, name;

selectBudgetsForParent:
SELECT *
FROM accounts
WHERE parent_account_id = ? AND archived_at IS NULL
ORDER BY display_order, name;

-- How many active (non-archived) accounts use this name? Mirrors the partial
-- unique index so writes can return a typed DuplicateName up front instead of
-- parsing a constraint exception after the fact.
countActiveWithName:
SELECT COUNT(*) FROM accounts WHERE name = :name AND archived_at IS NULL;

insert:
INSERT INTO accounts (
  id, name, type, currency, parent_account_id,
  opening_balance_minor, color, icon, display_order,
  created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateBasics:
UPDATE accounts
SET name          = :name,
    color         = :color,
    icon          = :icon,
    display_order = :displayOrder,
    updated_at    = :updatedAt
WHERE id = :id;

archive:
UPDATE accounts
SET archived_at = :archivedAt,
    updated_at  = :updatedAt
WHERE id = :id AND archived_at IS NULL;

unarchive:
UPDATE accounts
SET archived_at = NULL,
    updated_at  = :updatedAt
WHERE id = :id;

-- Computed balance for one account.
balance:
SELECT
  a.opening_balance_minor
    + COALESCE((SELECT SUM(amount_minor) FROM transactions WHERE to_account_id   = a.id), 0)
    - COALESCE((SELECT SUM(amount_minor) FROM transactions WHERE from_account_id = a.id), 0)
    AS balance_minor
FROM accounts a
WHERE a.id = ?;

-- All active accounts with computed balances. Powers Home grid and Accounts list.
-- `a.*` carries every column (color, icon, timestamps) so the row maps to a full
-- Account; `balance_minor` is the computed balance alongside it.
balanceForAll:
SELECT
  a.*,
  a.opening_balance_minor
    + COALESCE((SELECT SUM(amount_minor) FROM transactions WHERE to_account_id   = a.id), 0)
    - COALESCE((SELECT SUM(amount_minor) FROM transactions WHERE from_account_id = a.id), 0)
    AS balance_minor
FROM accounts a
WHERE a.archived_at IS NULL
ORDER BY a.type DESC, a.display_order, a.name;

-- Headline "Total" on Home: sum across all active accounts (REAL + BUDGET).
totalBalance:
SELECT
  COALESCE(SUM(
    a.opening_balance_minor
    + COALESCE((SELECT SUM(amount_minor) FROM transactions WHERE to_account_id   = a.id), 0)
    - COALESCE((SELECT SUM(amount_minor) FROM transactions WHERE from_account_id = a.id), 0)
  ), 0) AS total_minor
FROM accounts a
WHERE a.archived_at IS NULL;
